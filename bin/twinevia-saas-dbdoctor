#!/usr/bin/env bash
set -euo pipefail

TWINEVIA_SAAS_PYTHON="${TWINEVIA_SAAS_PYTHON:-/opt/twinevia-saas/venv/bin/python}"

if [[ ! -x "${TWINEVIA_SAAS_PYTHON}" ]]; then
  echo "ERROR: Python interpreter not found at ${TWINEVIA_SAAS_PYTHON}." >&2
  echo "Set TWINEVIA_SAAS_PYTHON to the SaaS venv python path, e.g. /opt/twinevia-saas/venv/bin/python." >&2
  exit 1
fi

exec "${TWINEVIA_SAAS_PYTHON}" -m app.saas_db "$@"
