#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CANONICAL_BIN="${TWINEVIA_SAAS_DBDOCTOR_BIN:-${SCRIPT_DIR}/twinevia-saas-dbdoctor}"

if [[ "$(basename "$0")" != "twinevia-saas-dbdoctor" && -x "${CANONICAL_BIN}" ]]; then
  exec "${CANONICAL_BIN}" "$@"
fi

resolve_saas_app_root() {
  if [[ -n "${TWINEVIA_SAAS_APP_ROOT:-}" ]]; then
    printf '%s\n' "${TWINEVIA_SAAS_APP_ROOT}"
    return
  fi
  if [[ -n "${APP_ROOT:-}" ]]; then
    printf '%s\n' "${APP_ROOT}"
    return
  fi
  if [[ -x "/opt/twinevia-saas/venv/bin/python" ]]; then
    printf '/opt/twinevia-saas\n'
    return
  fi
  printf '/opt/twinevia-saas\n'
}

DEFAULT_SAAS_APP_ROOT="$(resolve_saas_app_root)"
TWINEVIA_SAAS_PYTHON="${TWINEVIA_SAAS_PYTHON:-${DEFAULT_SAAS_APP_ROOT}/venv/bin/python}"

if [[ ! -x "${TWINEVIA_SAAS_PYTHON}" ]]; then
  echo "ERROR: Python interpreter not found at ${TWINEVIA_SAAS_PYTHON}." >&2
  echo "Set TWINEVIA_SAAS_PYTHON or TWINEVIA_SAAS_APP_ROOT to the SaaS runtime path, e.g. /opt/twinevia-saas/venv/bin/python." >&2
  exit 1
fi

exec "${TWINEVIA_SAAS_PYTHON}" -m app.saas_db "$@"
