# Twinevia local SaaS bootstrap defaults
#
# This file is intentionally development-friendly. Do not copy it directly to a
# live SaaS host. For production values, use docs/deployment.md or
# docs/ubuntu-vps-saas-checklist.md and keep PostgreSQL, FLASK_ENV=production,
# secure cookies, real TRUSTED_HOSTS, and fake Stripe/Twilio flags disabled.

# Required SaaS runtime flags
SAAS_MODE=1
SAAS_BASE_URL=http://127.0.0.1:5000
PUBLIC_BASE_URL=https://public.local.test
APP_BASE_URL=https://app.local.test
DATABASE_URL=sqlite:///instance/twinevia.db
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=twinevia-saas

# Required secrets and external providers
SECRET_KEY=change-this-to-a-random-secret-key
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_monthly_replace_me
STRIPE_MONTHLY_PRICE_ID=price_monthly_replace_me
STRIPE_ANNUAL_PRICE_ID=price_annual_replace_me
STRIPE_ACTIVATION_PRICE_ID=price_activation_replace_me
STRIPE_STAGED_ACTIVATION_PRICE_ID=price_staged_activation_replace_me
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_VALID_FERNET_KEY

# First platform admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-bootstrap-password

# Local bootstrap note:
# Keep FLASK_ENV=development here for local setup. Live SaaS deploys must switch
# to FLASK_ENV=production with PostgreSQL and public hostname settings.
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Production-only SaaS settings
# ---------------------------------------------------------------------------

# TRUST_PROXY=1
# TRUSTED_HOSTS=app.example.com,www.example.com
# SESSION_COOKIE_SECURE=1
# REMEMBER_COOKIE_SECURE=1
# SESSION_COOKIE_SAMESITE=Lax
# SECURITY_HEADERS_ENABLED=1
# SECURITY_HSTS_ENABLED=1
# SECURITY_HSTS_MAX_AGE=31536000
# FLASK_DEBUG=0
# STRIPE_FAKE_CHECKOUT_ENABLED=0
# TWILIO_BROWSER_FAKE_SENDS=0
# TWILIO_A2P_FAKE_QUEUE=0
# SCHEDULER_ENABLED=0
# MANAGED_PILOT_ENABLED=1
# PUBLIC_BASE_URL=https://twinevia.com
# APP_BASE_URL=https://app.twinevia.com
# TRUSTED_HOSTS=twinevia.com,www.twinevia.com,app.twinevia.com
# READINESS_TOKEN=replace-with-at-least-32-random-characters
# READINESS_SYSTEMCTL_TIMEOUT_SECONDS=5
# READINESS_REQUIRED_SYSTEMD_TIMERS=twinevia-saas-scheduler.timer,twinevia-saas-billing-reconcile.timer,twinevia-saas-a2p-reconcile.timer,twinevia-saas-backup.timer,twinevia-saas-readiness.timer
# ALERT_WEBHOOK_URL=https://alerts.example.com/replace-me
# UPTIME_MONITOR_HEARTBEAT_URL=https://monitor.example.com/replace-me
# BACKUP_LOCAL_DIR=/var/backups/twinevia-saas
# BACKUP_OFFSITE_DESTINATION=/mnt/twinevia-offsite
# BACKUP_ENCRYPTION_PASSPHRASE_FILE=/etc/twinevia-saas/backup-passphrase
# BACKUP_STATUS_FILE=/var/lib/twinevia-saas/backup-status.json
# RESTORE_DRILL_STATUS_FILE=/var/lib/twinevia-saas/restore-drill-status.json
# RESTORE_DRILL_DATABASE_URL=postgresql+psycopg://restore_user:replace-me@127.0.0.1:5432/twinevia_restore_drill
# RESTORE_DRILL_DATABASE_NAME=twinevia_restore_drill
# AOC_SCHEDULED_CANCELLATION_RECORD_FILE=/var/lib/twinevia-saas/aoc-scheduled-cancellations/managed-pilot-launch.json

# ---------------------------------------------------------------------------
# Optional SaaS Twilio settings
# ---------------------------------------------------------------------------

# Recommended for production REST auth. If you set one, set both.
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=replace_me

# Optional product and safety controls
# TWILIO_VALIDATE_INBOUND_SIGNATURE=1
# TWILIO_PLATFORM_FRIENDLY_NAME=Twinevia
# TWILIO_A2P_ONBOARDING_ENABLED=0
# TWILIO_A2P_NUMBER_COUNTRY=US
# TWILIO_A2P_FAKE_QUEUE=0
# TWILIO_A2P_EVENT_STREAMS_ENABLED=0
# TWILIO_A2P_EVENT_STREAM_AUTH_TOKEN=replace_me
# When A2P automation is enabled this must be the primary Trust Hub customer-profile
# bundle SID (BU...), not an address or supporting-document bundle.
# TWILIO_PRIMARY_CUSTOMER_PROFILE_SID=BUxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional inbound automation controls
# INBOUND_AUTO_REPLY_ENABLED=1
# SURVEY_AMBIGUOUS_DUPLICATE_WINDOW_SECONDS=3

# ---------------------------------------------------------------------------
# Optional billing and usage controls
# ---------------------------------------------------------------------------

# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# STRIPE_FAKE_CHECKOUT_ENABLED=0
# STRIPE_MONTHLY_PRICE_ID=price_monthly_replace_me
# STRIPE_ANNUAL_PRICE_ID=price_annual_replace_me
# STRIPE_GROWTH_PRICE_ID=price_growth_replace_me
# STRIPE_SCALE_PRICE_ID=price_scale_replace_me
# BILLING_TRIAL_DAYS=0
# BILLING_INCLUDED_OUTBOUND_SEGMENTS=1000
# BILLING_MONTHLY_INCLUDED_OUTBOUND_SEGMENTS=1000
# BILLING_ANNUAL_INCLUDED_OUTBOUND_SEGMENTS=1000
# BILLING_GROWTH_INCLUDED_OUTBOUND_SEGMENTS=3000
# BILLING_SCALE_INCLUDED_OUTBOUND_SEGMENTS=10000
# BILLING_USAGE_CURRENCY=usd
# BILLING_OUTBOUND_SEGMENT_RATE_USD=0.0300
# BILLING_MONTHLY_PRICE_USD=59.99
# BILLING_ANNUAL_PRICE_USD=600.00
# BILLING_ACTIVATION_FEE_USD=149.00
# BILLING_STAGED_ACTIVATION_FEE_USD=150.00
# Break-glass fallback for annual-only checkout. Prefer the platform admin
# organization billing-offer toggle for normal customer setup.
# BILLING_ANNUAL_ONLY_ORG_SLUGS=first-client-slug
# BILLING_ANNUAL_ONLY_ORG_IDS=1

# ---------------------------------------------------------------------------
# Optional platform restart control
# ---------------------------------------------------------------------------

# PLATFORM_SERVICE_RESTART_ENABLED=0
# PLATFORM_SERVICE_RESTART_SCRIPT=/usr/local/bin/restart-twinevia-saas-services
# PLATFORM_SERVICE_RESTART_TIMEOUT_SECONDS=15
# PLATFORM_SERVICE_RESTART_STALE_AFTER_SECONDS=300

# ---------------------------------------------------------------------------
# Optional scheduler, timezone, and local tooling controls
# ---------------------------------------------------------------------------

# In production use the systemd timers, not the in-process scheduler.
# SCHEDULER_ENABLED=0
# SCHEDULED_MESSAGE_MAX_LAG=1440
# SCHEDULED_PROCESSING_TIMEOUT_MINUTES=10
# SCHEDULED_SEND_MAX_RETRIES=3
# SCHEDULED_SEND_RETRY_BACKOFF_SECONDS=60
# SCHEDULED_SEND_RETRY_MAX_BACKOFF_SECONDS=900
# APP_TIMEZONE=UTC
# PLAYWRIGHT_ARTIFACT_DIR=

# ---------------------------------------------------------------------------
# Session and auth hardening
# ---------------------------------------------------------------------------

# SESSION_IDLE_TIMEOUT_MINUTES=30
# REMEMBER_COOKIE_DURATION_DAYS=7
# AUTH_ATTEMPT_WINDOW_SECONDS=300
# AUTH_LOCKOUT_SECONDS=900
# AUTH_MAX_ATTEMPTS_IP_ACCOUNT=5
# AUTH_MAX_ATTEMPTS_ACCOUNT=8
# AUTH_MAX_ATTEMPTS_IP=30
# AUTH_PASSWORD_MIN_LENGTH=12
# AUTH_PASSWORD_POLICY_ENFORCE=1
# PASSWORD_HISTORY_COUNT=3
# AUTH_ALERTS_ENABLED=1
# AUTH_EVENT_RETENTION_DAYS=180
# AUTH_LOCKOUT_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# Development helpers
# ---------------------------------------------------------------------------

# Optional: force debug mode in addition to FLASK_ENV=development
# FLASK_DEBUG=1

# Local demo defaults often used with ./run/local_saas_stack.sh
# SAAS_BASE_URL=http://127.0.0.1:5000
# DATABASE_URL=sqlite:///instance/twinevia.db
# REDIS_URL=redis://localhost:6379/0
# RQ_QUEUE_NAME=twinevia-saas

# ---------------------------------------------------------------------------
# Legacy single-tenant compatibility section
# ---------------------------------------------------------------------------

# The settings below matter only for the secondary single-tenant runtime
# (`SAAS_MODE=0`) that uses `dbdoctor`, `/opt/sms-admin`, and `sms*` units.

# Legacy sender identity
# TWILIO_FROM_NUMBER=+1234567890

# Legacy queue name and DB examples
# SAAS_MODE=0
# DATABASE_URL=sqlite:///instance/sms.db
# RQ_QUEUE_NAME=sms

# Legacy scheduler note
# In legacy production, keep SCHEDULER_ENABLED=0 and use sms-scheduler.timer.
