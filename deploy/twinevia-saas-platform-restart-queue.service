[Unit]
Description=Twinevia SaaS Platform Restart Queue Processor (oneshot)
After=network.target

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__/current
EnvironmentFile=-__APP_ROOT__/.env
EnvironmentFile=__APP_ROOT__/current/.release.env
Environment="PATH=__APP_ROOT__/current/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="APP_ROOT=__APP_ROOT__/current"
Environment="TWINEVIA_ENV_FILE=__APP_ROOT__/.env"
Environment="SAAS_MODE=1"
Environment="FLASK_ENV=production"
Environment="FLASK_DEBUG=0"
PrivateTmp=true
ProtectHome=true
SystemCallArchitectures=native
UMask=0077
ExecStartPre=__APP_ROOT__/current/deploy/check_python_runtime.sh
ExecStartPre=__TWINEVIA_SAAS_DBDOCTOR_DEST__ --apply
ExecStart=/bin/bash __APP_ROOT__/current/deploy/run_platform_restart_queue_once.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=twinevia-saas-platform-restart-queue
