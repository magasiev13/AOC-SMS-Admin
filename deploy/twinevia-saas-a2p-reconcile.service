[Unit]
Description=Twinevia SaaS Twilio A2P Reconciliation Service (oneshot)
After=network.target

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__
Environment="PATH=__APP_ROOT__/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="APP_ROOT=__APP_ROOT__"
Environment="SAAS_MODE=1"
EnvironmentFile=-__APP_ROOT__/.env
ExecStartPre=__APP_ROOT__/deploy/check_python_runtime.sh
ExecStartPre=__TWINEVIA_SAAS_DBDOCTOR_DEST__ --apply
ExecStart=/bin/bash __APP_ROOT__/deploy/run_a2p_reconcile_once.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=twinevia-saas-a2p-reconcile
