[Unit]
Description=Twinevia SaaS Stripe Billing Reconciliation Service (oneshot)
After=network.target

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_ROOT__
EnvironmentFile=-__APP_ROOT__/.env
Environment="PATH=__APP_ROOT__/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="APP_ROOT=__APP_ROOT__"
Environment="SAAS_MODE=1"
Environment="FLASK_ENV=production"
Environment="FLASK_DEBUG=0"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
ExecStartPre=__APP_ROOT__/deploy/check_python_runtime.sh
ExecStartPre=__TWINEVIA_SAAS_DBDOCTOR_DEST__ --apply
ExecStart=/bin/bash __APP_ROOT__/deploy/run_billing_reconcile_once.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=twinevia-saas-billing-reconcile
